[Unit]
Description=GPU opt-in newsletter queue
After=network.target gpu-workshop.service postfix.service
[Service]
Type=oneshot
DynamicUser=yes
User=gpu-workshop
StateDirectory=gpu-workshop
StateDirectoryMode=0700
WorkingDirectory=/opt/gpu-workshop/current
Environment=GPU_DB=/var/lib/gpu-workshop/workshop.sqlite3
EnvironmentFile=/etc/gpu-workshop/notifications.env
ExecStart=/usr/bin/python3 /opt/gpu-workshop/current/manage.py notify
TimeoutStartSec=420
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_INET AF_UNIX
UMask=0077
